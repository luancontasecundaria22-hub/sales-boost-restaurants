# Variáveis de ambiente para as Edge Functions do Supabase
# Configure estas chaves em:
# supabase.com/dashboard/project/miwcxakzyforbahpnpst → Settings → Edge Functions → Secrets

# Google PageSpeed Insights API — para diagnóstico de sites
# Como obter: console.cloud.google.com → APIs → PageSpeed Insights API → Credenciais → Criar chave
# (Opcional para MVP — funciona sem chave com quota reduzida)
PAGESPEED_API_KEY=AIza...

# Apify Token — para varredura de reviews, Google Maps e redes sociais
# Como obter: apify.com → Settings → Integrations → API tokens
APIFY_TOKEN=apify_api_...

# Claude / Anthropic API — para analisar reviews e gerar relatórios
# Como obter: console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API — para mapear concorrentes (requer billing ativo no Google Cloud)
# Como obter: console.cloud.google.com → APIs → Places API → Credenciais → Criar chave de API
GOOGLE_PLACES_API_KEY=AIza...

# Estas são injetadas automaticamente pelo Supabase (não precisa configurar):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
