# Frontend (Vite) — copie para .env.local e preencha
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# PostHog — analytics de produto (funis/gráficos agregados por empresa).
# Sem a KEY o PostHog fica desligado de forma graciosa; o diário do cliente
# (client_activity) continua funcionando. A chave phc_ é pública (só envia
# eventos, não lê nada), pode ir no build do frontend.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
