# Frontend (Vite) — copie para .env.local e preencha
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# PostHog — analytics de produto (funis/gráficos agregados por empresa).
# Sem a KEY o PostHog fica desligado de forma graciosa; o diário do cliente
# (client_activity) continua funcionando. A chave phc_ é pública (só envia
# eventos, não lê nada), pode ir no build do frontend.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Facebook / Meta — SDK JavaScript no site (exigência da Meta p/ liberar o app).
# O App ID do Facebook é PÚBLICO (vai no SDK do browser por design), pode ir no
# build do frontend. Sem ele, o SDK fica desligado de forma graciosa.
# Encontre em developers.facebook.com → seu app → Configurações → Básico.
VITE_FACEBOOK_APP_ID=
# Opcional — versão da Graph API (padrão v21.0, igual às edge functions).
VITE_FACEBOOK_API_VERSION=v21.0
